# All optional. Provider credentials are entered in the dashboard, never here.

# Public address of EvoBridge, used to register webhooks in Evolution Go and Chatwoot.
PUBLIC_URL=

# Allow Evolution Go / Chatwoot on private addresses (10.x, 192.168.x, Docker networks).
ALLOW_PRIVATE_NETWORKS=false

# 32-byte key (64 hex chars) for encrypting credentials at rest.
# If unset, one is generated on first start and kept in the data volume.
# ENCRYPTION_KEY=

# PORT=3000
# LOG_LEVEL=info
# TRUST_PROXY=loopback,linklocal,uniquelocal
